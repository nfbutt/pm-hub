{
  "name": "pm-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Roadmaps, Gantt charts and delivery forecasts for any GitHub Project. Runs entirely in your browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
